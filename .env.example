VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_PUBLIC_APP_URL="https://forms.example.com"
VITE_PIXEL_ALLOWED_HOSTS="forms.example.com"

# Segredos do bootstrap inicial pertencem somente às Edge Functions e nunca
# devem receber o prefixo VITE_. Cadastre-os com `supabase secrets set`, deixe
# SETUP_ENABLED=false por padrão e remova/rotacione o token após o primeiro uso.
SETUP_ENABLED="false"
SETUP_TOKEN=""
